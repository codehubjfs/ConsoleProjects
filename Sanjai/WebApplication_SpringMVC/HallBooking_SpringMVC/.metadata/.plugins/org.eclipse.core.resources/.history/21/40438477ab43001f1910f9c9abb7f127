<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const data = [100, 150, 80]; // Example data for the bars

        const barGraph = document.getElementById('barGraph');

        data.forEach((value, index) => {
            const bar = document.createElement('div');
            bar.classList.add('bar');
            bar.style.height = value + 'px'; // Set the height of the bar
            bar.style.backgroundColor = getRandomColor(); // Random color for each bar

            const label = document.createElement('span');
            label.classList.add('bar-label');
            label.textContent = 'Bar ' + (index + 1);

            barGraph.appendChild(bar);
            barGraph.appendChild(label);
        });

        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }
    });



    document.addEventListener('DOMContentLoaded', (event) => {
        var ctx = document.getElementById('barChart').getContext('2d');
