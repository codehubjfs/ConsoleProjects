    .outerCard {
     justify-content: center;
     align-items: center;
     display: flex; 
     width: 350px; 
     height: 500px; 
     margin: 0 auto 20px auto;
     overflow: hidden;
     border: 1px solid #ddd; 
     border-radius: 5px; 
     box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); 
     box-sizing: border-box;
     transition: transform 0.3s ease;
 }
 
 .inner-image img:hover {
     transform: scale(1.05);
 }
 
 .innerCard {
     margin-top: 7%;
     margin-bottom: 2%;
     margin-left: 10%;
     margin-right: 10%;
     display: flex;
     flex-direction: column; 
     justify-content: center;
     align-items: center;
     width: calc(100% - 20px);
     height: calc(100% - 20px);
     box-sizing: border-box; 
 }
 
 .inner-image img {
     margin-top: 2%;
     width: 300px;
     height: 300px;
     transition: 0.2s ease-in-out;
     border-radius: 10px;
 }
 
 .blog-title {
     margin-top: 5px;
     font-size: 1rem;
     font-weight: bold;
     padding: 0 10px;
     overflow: hidden;
     text-overflow: ellipsis; 
     display: -webkit-box; 
     -webkit-line-clamp: 2;
     -webkit-box-orient: vertical;
     word-wrap: break-word;
 }
 
 .blog-date {
     font-size: 0.875rem;
     color: gray;
     padding: 0 5px;
     word-wrap: break-word;
 }
 
 .blog-content {
     padding: 0 5px; 
     font-size: 0.9rem; 
     color: #333; 
     overflow: hidden; 
     text-overflow: ellipsis; 
     display: -webkit-box;
     -webkit-line-clamp: 3;
     -webkit-box-orient: vertical;
     word-wrap: break-word; 
     height: 65px; 
 
 }
 
