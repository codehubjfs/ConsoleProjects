package com.hallbookingmanagement.controller;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.ModelAndView;

import com.hallbookingmanagement.service.CustomerServices;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Controller
public class ForgetPasswordController {
	
	@Autowired
	CustomerServices customerServices;
	
	@GetMapping("/forgetPassword")
	public ModelAndView giveForgetPassword(@RequestParam("email") String mail,HttpServletResponse response, HttpServletRequest request, ModelAndView model) {
		Map<String,String> error= customerServices.forgetPassword(request, response, mail);
		if(error.size()==0) {
			model.addAllObjects("emailNotExisted",error);
			model.setViewName("viewLogin");
		}
		model.setViewName("OtpVerifier");
		return model;
	}
	
}
