    <div class="modal" id="conflict-modal" tabindex="-1" role="dialog">
    <form action="change-booking" method="get">
		  <div class="modal-dialog" role="document">
		    <div class="modal-content">
		      <div class="modal-header">
		        <h5 class="modal-title">Booking Conflict occur</h5>
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
		          <span aria-hidden="true">&times;</span>
		          <input  name="currentBookId" id="currentBookId"/>
		          <input  name="changeBookId" id="changeBookId">
		        </button>
		      </div>
		      <div class="modal-body">
		      <p><strong><span id="conf-username"></span> is already in Confirmed booking</strong></p>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-outline-warning" class="conflict-close">Continue</button>
		        <button type="button" class="btn btn-secondary" id="conf-close" data-dismiss="modal">Close</button>
		      </div>
		    </div>
		  </div>
	  </form>
