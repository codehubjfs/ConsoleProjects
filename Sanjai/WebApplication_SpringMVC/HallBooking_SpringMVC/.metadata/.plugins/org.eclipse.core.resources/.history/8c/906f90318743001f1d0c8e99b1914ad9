	@Override
	public boolean requestHall(HttpServletRequest request, String event, String seat, LocalDate bookedDate,
	        int numberOfDays) {
	    try {
	        Hall hall = (Hall) request.getSession().getAttribute("hallDetail");
	        int hallid = hall.getHallId();
	        Customer customer = (Customer) request.getSession().getAttribute("customer");
	        int userId = customer.getUserId();
	        int bookedEvent = hall.getEvents().stream()
	            .filter(x -> x.getEventName().equals(event))
	            .findFirst()
	            .orElseThrow(() -> new NoSuchElementException("Event not found"))
	            .getEventId();
	        int bookedSeat = hall.getSeat().stream()
	            .filter(x -> x.getArrangementType().equals(seat))
	            .findFirst()
	            .orElseThrow(() -> new NoSuchElementException("Seat not found"))
	            .getSeatId();

	        Seats seatObj = new Seats();
	        seatObj.setSeatId(bookedSeat);
	        Event eventObj = new Event();
	        eventObj.setEventId(bookedEvent);

	        int maxId = DAOFactory.getBookingDao().getAllBookings().stream()
	            .max(Comparator.comparingInt(Booking::getBookingId))
	            .map(Booking::getBookingId)
	            .orElse(0);

	        Booking booking = new Booking();
	        booking.setBookingId(maxId + 1);
	        booking.setCustomer(customer);
	        booking.setHall(hall);
	        booking.setRequestedTime(LocalDateTime.now());
	        booking.setStartDate(bookedDate);
	        booking.setEndDate(bookedDate.plusDays(numberOfDays));
	        booking.setBookStatus("PENDING");

	        int added = DAOFactory.getBookingDao().addBooking(booking);
	        if (added > 0) {
	            System.out.println("Booking added successfully");
	            return true;
	        }
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	    return false;
	}
	
