	@Override
	public boolean paymentbooking(int bookId,String paymentType, double paymentPrice) {
		try {
			
			Payment payment =  paymentList().stream().filter(x->x.getBook().getBookingId()==bookId).findFirst().orElse(null);
			if(payment==null) {
				payment = new Payment();
	            Booking book = listAllBooking().stream().filter(x->x.getBookingId()==bookId).findFirst().orElse(null);
	            int paymentId = paymentList().stream().mapToInt(Payment::getPaymentId).max().orElse(0)+1;
	            payment.setPaymentId(paymentId);
	            payment.setBook(book);
	            payment.setPaidStatus(paymentType);
	            payment.setPrice(paymentPrice);
	            payment.setPaymentTime(LocalDateTime.now());
	            DAOFactory.getPaymentDao().insertPayment(payment);
	            book.setBookStatus("CONFIRMED");
	            DAOFactory.getBookingDao().updateBooking(book);
	            return true;
			}
		else {
			Booking book = listAllBooking().stream().filter(x->x.getBookingId()==bookId).findFirst().orElse(null);
			payment.setBook(book);
			payment.setPaidStatus(paymentType);
			payment.setPaymentTime(LocalDateTime.now());
			DAOFactory.getPaymentDao().insertPayment(payment);
			return true;
		}
		
		}
		catch (Exception e) {
			e.printStackTrace();
		}
		return false;
	}

