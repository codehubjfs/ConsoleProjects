	@Override
	public List<Booking> listAllBooking() {
		try {
			List<Booking> booking = new ArrayList<Booking>();
			List<Customer> customerList = DAOFactory.getCustomerDao().getAllCustomer();
			List<Hall> hallList = DAOFactory.getHallDao().getAllHalls();
			List<Booking> allbooking = DAOFactory.getBookingDao().getAllBookings();
			for(Booking book: allbooking) {
				int userId = book.getCustomer().getUserId();
				int hallId = book.getHall().getHallId();
				Hall hall = hallList.stream().filter(x->x.getHallId()==hallId).findFirst().orElse(null);
				Customer customer = customerList.stream().filter(x->x.getUserId()==userId).findFirst().orElse(null);
				book.setHall(hall);
				book.setCustomer(customer);
				booking.add(book);
			}
			return booking;
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return null;
	}
	
	
