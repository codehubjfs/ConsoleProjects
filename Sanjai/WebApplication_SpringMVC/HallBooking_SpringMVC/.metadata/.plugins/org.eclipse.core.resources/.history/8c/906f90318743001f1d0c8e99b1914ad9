	public boolean validateUsers(String name, String password, HttpServletRequest request) {
	    try {
	     
	        CustomerMapper mapper = DAOFactory.getCustomerDao();
	        List<Customer> customerList = mapper.getAllCustomer();
	        
	        boolean isUser = customerList.stream()
	            .anyMatch(x -> x.getUserName().equals(name) && x.getPassword().equals(password));
	        
	        if (isUser) {
	            Customer customer = customerList.stream()
	                .filter(x -> x.getUserName().equals(name) && x.getPassword().equals(password))
	                .findFirst()
	                .orElse(null);
	            
	            if (customer != null && request != null) {
	                request.getSession().setAttribute("customer", customer);
	            }
	        }

	        return isUser;
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	    return false;
	}

	@Override
	public HashMap<String,String> registerUser(String name, String gender, String emailId, String phone,
			String Address, String userName, String Password) {
		try {
			HashMap<String,String> errorMessages = new HashMap<String, String>();
			List<Customer> customerList =  DAOFactory.getCustomerDao().getAllCustomer();
			boolean userNameExisted = customerList.stream().anyMatch(x->x.getUserName().equals(userName));
			boolean userPhoneExisted = customerList.stream().anyMatch(x->x.getNumber().equals(phone));
			boolean userEmailExisted = customerList.stream().anyMatch(x->x.getEmailId().equals(emailId));
			if(userPhoneExisted) {
				errorMessages.put("phoneError", "Mobile number is already Existed");
				
			}
			if(userNameExisted) {
				errorMessages.put("username", "Username is already existed please give another username");
				
			}
			if(userEmailExisted) {
				errorMessages.put("emailError", "Email-Id is already existed");
			}
			
			return errorMessages;
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return null;
			
	}	

	
	
	@Override
	public int addCustomer(String name, String gender, String email, String phone, String address, String username,
			String password,HttpServletRequest request) {
		int numberOfRowsAffected = 0 ;
		try {
			int primaryKey = DAOFactory.getCustomerDao().getAllCustomer().stream()
			    .mapToInt(Customer::getUserId)
			    .max()
			    .orElseThrow(() -> new RuntimeException("No customers found"));
			System.out.println("PrimaryKey :"+primaryKey);
			customer.setUserId(primaryKey+1);
			customer.setName(name);
			customer.setGender(gender);
			customer.setAccountStatus("Active");
			customer.setNumber(phone);
			customer.setAddress(address);
			customer.setUserName(username);
			customer.setPassword(password);
			customer.setEmailId(email);
			customer.setAccountType("Customer");
			request.getSession().setAttribute("customer", customer);
			numberOfRowsAffected = DAOFactory.getCustomerDao().addCustomer(customer);
			if(numberOfRowsAffected>0) {
				System.out.println("Added Success fully");
			}
		}
		catch (Exception e) {
			e.printStackTrace();
		}
		return numberOfRowsAffected;
	}

	
