	@Override
	public boolean validateAdmin(String name,String password, HttpServletRequest request){
		try {
			CustomerMapper mapper = DAOFactory.getCustomerDao();
			List<Customer> customerList = mapper.getAllCustomer();
			boolean isUser = customerList.stream().anyMatch(x->x.getUserName().equals(name) && x.getPassword().equals(password) && x.getAccountType().equals("ADMIN"));
			if (isUser) {
	            Customer customer = customerList.stream().filter(x -> x.getUserName().equals(name) && x.getPassword().equals(password) && x.getAccountType().equals("ADMIN")).findFirst().orElse(null);
	            if (customer != null && request != null) {
	                request.getSession().setAttribute("userName", customer);
	            }
			}
			return isUser;
		}
		catch(Exception e){
			e.printStackTrace();
		}
	return true;
	}
	
