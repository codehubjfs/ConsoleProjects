	@Override
	public boolean addHallAndProperties(String name, String isAc, double price, int capacity, String location,
			String locationLink, String[] amenities, String[] events, int theater, int cluster, int banquet,
			int uShaped, int hallowSquare, int cabaretStyle) {
		try {
			int hallId = customerServices.showHall().stream().mapToInt(Hall::getHallId).max().orElseThrow(() -> new RuntimeException("No customers found"))+1;
			System.out.println("hall Id"+hallId);
			hall.setHallId(hallId);
			hall.setHallName(name);
			hall.setIsAcHall(isAc.equals("yes"));
			hall.setPrice(price);
			hall.setCapacity(capacity);
			hall.setLocation(location);
			hall.setLocationLink(locationLink);
			DAOFactory.getHallDao().insertHall(hall);
			List<ArrangementHallRelation> seatingArrangements = new ArrayList<>();
            seatingArrangements.add(new ArrangementHallRelation(hallId,1, theater));
            seatingArrangements.add(new ArrangementHallRelation(hallId,10, cluster));
            seatingArrangements.add(new ArrangementHallRelation(hallId,3, banquet));
            seatingArrangements.add(new ArrangementHallRelation(hallId,4, uShaped));
            seatingArrangements.add(new ArrangementHallRelation(hallId,7, hallowSquare));
            seatingArrangements.add(new ArrangementHallRelation(hallId,6, cabaretStyle));
            for(ArrangementHallRelation arrangement: seatingArrangements) {
            	if(arrangement.getCapacity()!=0) {
            		DAOFactory.getHallDao().insertSeatForHall(arrangement);
            	}
            }
            
            List<String> amenityList = Arrays.asList(amenities);
            
            List<AmenityHallRelation> hallsAmenity = DAOFactory.getHallDao().getAllAmenities().stream()
            	    .filter(x -> amenityList.contains(x.getAmenityType()))
            	    .map(x -> new AmenityHallRelation(hallId, x.getAmenityId()))
            	    .collect(Collectors.toList());  
            
            List<String> eventList = Arrays.asList(events);
            
            List<HallEventRelation> hallsEvent = DAOFactory.getHallDao().getAllEvents().stream()
            	    .filter(x -> eventList.contains(x.getEventName()))
            	    .map(x -> new HallEventRelation(hallId, x.getEventId()))
            	    .collect(Collectors.toList());  
            
            for(HallEventRelation eventForHall:hallsEvent) {
            	DAOFactory.getHallDao().insertEventForHall(eventForHall);
            }
            for(AmenityHallRelation amenityForHall:hallsAmenity) {
            	DAOFactory.getHallDao().insertAmenityForHall(amenityForHall);
            }
            
            System.out.println(hallsEvent);
            System.out.println(hallsAmenity);
           
		}
		catch (Exception e) {
			e.printStackTrace();
		}
		
		return false;
	}
	
	@Override
	public Booking checkConflict(int bookId) {
		List<Booking> bookingList = customerServices.listAllBooking();
		Booking changeBooking  = bookingList.stream().filter(x->x.getBookingId()==bookId).findFirst().orElse(null);
		
		Booking conflictBooking = new Booking();
		for(Booking book: bookingList) {
			if (book.getBookStatus().equals("CONFIRMED") && changeBooking.getHall().getHallId()==book.getHall().getHallId()) {
	            if ((book.getStartDate().isBefore(changeBooking.getEndDate()) || book.getStartDate().isEqual(changeBooking.getEndDate())) &&
	                (book.getEndDate().isAfter(changeBooking.getStartDate()) || book.getEndDate().isEqual(changeBooking.getStartDate()))) {
	            	conflictBooking = book; // Conflict found
	            }
	        }
		}
		return conflictBooking;
	}
	
