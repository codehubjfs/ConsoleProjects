package com.hallbookingmanagement.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.ModelAndView;

import com.hallbookingmanagement.service.AdminServices;

import jakarta.servlet.http.HttpServletRequest;

@Controller
public class ResolveBooking {
	
	@Autowired
	AdminServices adminServices;
	
	@RequestMapping("/change-booking")
	public ModelAndView resolveConflicBooking(@RequestParam("currentBookId") int currentBooking, 
			@RequestParam("changeBookId") int changeBookId, ModelAndView model, HttpServletRequest request) {
			adminServices.changeBooking(currentBooking,changeBookId);
			model.setViewName("redirect:/showManagebooking");
		return model;
		
	}

}
