                                <th>Hall Name</th>
                                <th>Floating Capacity</th>
                                <th>Price per Day</th> 
                                <th>Location</th>
                                <th id="action">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        <c:set var="count" value="${1}"/>
                            <c:forEach var="hall" items="${hallList}" varStatus="loop">
                            <c:if test='${hall.isAvail}'>
							    <tr>
							    	<td style="display: none" class="hallId">${hall.hallId}</td>
							        <td>${count}</td> <!-- loop.index starts from 0, so adding 1 gives 1-based index -->
							        <td class="hallname">${hall.hallName}</td>
							        <td class="capacity">${hall.capacity}</td>
							        <td class="price">${hall.price}</td>
							        <td class="location">${hall.location}</td>
							        <td class="locationLink" style="display: none">${hall.locationLink}</td>
							        <td class="d-flex justify-content-center">
							            <button class="btn btn-outline-primary edit-btn ms-1" data-toggle="tooltip" title="Edit"><i class="bi bi-pencil-square"></i></button>
            							<button class="btn btn-outline-secondary view-btn ms-1" data-bs-toggle="tooltip" title="View" onclick="showDetails(
									        '${hall.hallName}', 
									        '${hall.price}', 
									        '${hall.isAcHall}', 
									        '${hall.capacity}', 
									        '${hall.location}', 
									        <c:set var="resultString" value=""/>
									        <c:forEach var="event" items="${hall.events}">
													<c:set var="resultString" value="${resultString}${event.eventName}, " />
											</c:forEach>
											<c:set var="resultString" value="${fn:substring(resultString, 0, fn:length(resultString)-2)}" />
											'${resultString}', 
											
									        <c:set var="amenityStr" value=""/>
									        <c:forEach var="amenity" items="${hall.amenities}"> 
									         	 	<c:set var="amenityStr" value="${amenityStr}${amenity.amenityType}," />
									        </c:forEach>
									        <c:set var="amenityStr" value="${fn:substring(amenityStr, 0, fn:length(amenityStr)-2)}" />
									        '${amenityStr}',
									        '${hall.location}'
									    )">
									    <img src="<%= request.getContextPath() %>/assert/image/search.png" width="15px" />
									</button>
            							<button class="btn btn-outline-danger del-btn ms-1" id="del-btn" data-toggle="tooltip" title="Delete"><i class="bi bi-trash3" width="10px"></i></button>
							        </td>
							    </tr>
							    <c:set var="count" value="${count+1}"/>
							    </c:if>
							</c:forEach>
							<c:if test="${empty hallList}">
					        <tr>
					            <td colspan="6" class="text-center">No Halls are available.</td>
					        </tr>
					    </c:if>
