    <script>
    
    $(document).ready(function() {
        setTimeout(function() {
            $('#statusAlert').alert('close');
        }, 3000);
    });
    


    function showDetails(hallName, pricePerDay, isAcHall, capacity, location, events, amenities, seat) {
        document.getElementById("detailHallName").textContent = hallName;
        document.getElementById("detailPricePerDay").textContent = pricePerDay;
        document.getElementById("detailFloatingCapacity").textContent = capacity;
        document.getElementById("detailLocation").textContent = location;
        document.getElementById("detailAmenities").textContent = amenities; // Assuming amenities is an array
        document.getElementById("detailEvents").textContent = events; // Assuming events is an array
        var viewDetailsModal = new bootstrap.Modal(document.querySelector('#viewDetailsModal'));
        viewDetailsModal.show();
    }
    
    var isNameValidate = false;
    var isPriceValidate = false;
    var isFloatingValidate = false;
    var isLocationValidate = false;
    var isMultipleAmenties = false;
    var isLocationLink = false;
    var isMultipleEvents = false;
    var isSeats = false;
    var isAcYes = false;
    var isAcNo = false;
    
    var isAcSelected = false;
    var isAcYes = false;
    var isAcNo = false;

    document.getElementById("isAcYes").addEventListener("input", function () {
        isAcYes = true;
        isAcSelected =true;
    });

    document.getElementById("isAcNo").addEventListener("input", function () {
        isAcNo = true;
        isAcSelected =true;
    });
    

    document.getElementById("hallName").addEventListener("input", function () {
        var hallName = document.getElementById("hallName").value.trim();
        var hallNamePattern = /^(?=.*[A-Za-z].*[A-Za-z].*[A-Za-z])[A-Za-z\s]{3,30}$/;
        if (!hallNamePattern.test(hallName)) {
            document.getElementById("invalidName").style.display = "block";
            isNameValidate = false;
        } else {
            document.getElementById("invalidName").style.display = "none";
            console.log("hallname");
            isNameValidate = true;
        }
        checkAllValidations();
    });
   
    document.getElementById("pricePerDay").addEventListener("input", function() {
        var pricePerDay = document.getElementById("pricePerDay").value;
        var priceFeedback = document.getElementById("invalidPrice");

        var price = parseFloat(pricePerDay);

        // Check conditions and set validation messages
        if (isNaN(price) || price <= 0) {
            priceFeedback.textContent = "Please enter a positive price."; // Message for invalid input
