                <div class="table-responsive-lg">
                    <table id="hallTable" class="table table-bordered table-hover table-sm" style="width:100%;">
                        <thead class="thead">
                            <tr>
                                <th colspan="5"></th>
                                <th colspan="2"><button type="button" class="btn btn-primary"  id ="add-btn" >Add Hall</button></th>
                            </tr>
                            <tr>
                            <th style="display:none;">Id</th>
