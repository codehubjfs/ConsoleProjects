				boolean isUser = customerList.stream().anyMatch(x->x.getUserName().equals(name) && x.getPassword().equals(password));
				return isUser;
			}
			catch(Exception e){
				e.printStackTrace();
			}
		return true;
	}
	
	public boolean validateAdmin(String name,String password){
		try {
			CustomerMapper mapper = DAOFactory.getCustomerDao();
			List<Customer> customerList = mapper.getAllCustomer();
			boolean isUser = customerList.stream().anyMatch(x->x.getUserName().equals(name) && x.getPassword().equals(password) && x.getAccountType().equals("ADMIN"));
			return isUser;
		}
		catch(Exception e){
			e.printStackTrace();
		}
	return true;
	}

